# Copy this file to `.env` (`cp .env.example .env`): the application and
# docker-compose.yaml read it at startup. Every variable is described in the
# README, section "Configuration".

# ┌─ Authentication ──────────────────────────────────────────────────────────┐
# `dev`: dev login (GET /dev/login), without an identity provider. Anyone can
# log in as any user: NEVER USE IN PRODUCTION.
# `entra` (default when unset): Microsoft Entra ID, see the section below.
# `dev` ships here so that a fork starts without Entra credentials: every
# deployment requires `AUTH_MODE` unset or `entra` (README deployment checklist).
AUTH_MODE=dev

# Optional key required by the dev login (empty = open login). Ignored with
# AUTH_MODE=entra.
DEV_LOGIN_KEY=

# Allowed email domains, comma-separated.
ALLOWED_DOMAINS=epf.fr,epfedu.fr

# Session cookie signing key. Empty is fine in dev; required with
# AUTH_MODE=entra (README, section "Configuration").
SECRET_KEY=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Microsoft Entra ID (required with AUTH_MODE=entra) ──────────────────────┐
# Leave commented out in dev mode. Uncomment and fill in all four for
# AUTH_MODE=entra: the application refuses to start if any of the first three
# is missing.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# REDIRECT_URI=https://[CHANGE_THIS]/auth/callback
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Database ────────────────────────────────────────────────────────────────┐
# Directory of the SQLite database (default: database/ at the project root).
# With docker compose, the host directory mounted into the container.
LOCAL_DATABASE_DIR=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ LLM synthèses ───────────────────────────────────────────────────────────┐
# Key of the default LLM provider. Empty: the application starts, but
# requested synthèses are marked as a configuration error.
LLM_API_KEY=

# Set to 1 to start the synthèses daemon alongside uvicorn (how Docker gets
# one). Leave empty with launch.sh, which already runs the daemon.
RUN_SUMMARIES_DAEMON=
# └───────────────────────────────────────────────────────────────────────────┘
